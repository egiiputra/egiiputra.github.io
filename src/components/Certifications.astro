---
import certifications from '../data/certifications.json';
---

<div class="divide-y divide-border">
  {
    certifications.map((cert) => (
      <article class="py-7 first:pt-0 last:pb-0">
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <h3 class="text-base font-semibold tracking-tight">
            {cert.url ? (
              <a href={cert.url} class="inline-flex items-center gap-1.5">
                {cert.name}
                <svg
                  class="h-3.5 w-3.5 opacity-70"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M7 17 17 7M7 7h10v10" />
                </svg>
              </a>
            ) : (
              cert.name
            )}
          </h3>
          <span class="text-xs font-medium whitespace-nowrap text-muted">
            {cert.date}
          </span>
        </div>

        {cert.issuer && <p class="mt-1 text-sm text-muted">{cert.issuer}</p>}
      </article>
    ))
  }
</div>
