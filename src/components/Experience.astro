---
import experience from '../data/experience.json';
---

<div class="divide-y divide-border">
  {
    experience.map((job) => (
      <article class="py-7 first:pt-0 last:pb-0">
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <h3 class="text-base font-semibold tracking-tight">
            {job.role}
            <span class="font-normal text-muted"> · {job.company}</span>
          </h3>
          <span class="text-xs font-medium whitespace-nowrap text-muted">
            {job.period}
          </span>
        </div>

        {job.location && <p class="mt-1 text-sm text-muted">{job.location}</p>}

        <ul class="mt-4 space-y-2 text-sm text-muted">
          {job.highlights.map((item) => (
            <li class="flex gap-2.5">
              <span
                class="mt-[0.55rem] h-1.5 w-1.5 shrink-0 rounded-full bg-accent/60"
                aria-hidden="true"
              />
              <span>{item}</span>
            </li>
          ))}
        </ul>

        {job.technologies.length > 0 && (
          <div class="mt-5 flex flex-wrap gap-1.5">
            {job.technologies.map((tech) => (
              <span class="chip">{tech}</span>
            ))}
          </div>
        )}
      </article>
    ))
  }
</div>
